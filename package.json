{
  "name": "@oparamo/aframe-room-component",
  "version": "1.0.0",
  "description": "An A-Frame component for quickly creating rooms connected by doors.",
  "keywords": [
    "3d",
    "aframe-component",
    "aframe-vr",
    "aframe",
    "components",
    "room",
    "three.js",
    "three",
    "vr",
    "webvr",
    "webxr"
  ],
  "homepage": "https://github.com/oparamo/aframe-room-component#readme",
  "bugs": {
    "url": "https://github.com/oparamo/aframe-room-component/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oparamo/aframe-room-component.git"
  },
  "license": "MIT",
  "contributors": [
    {
      "name": "Hazel Fraticelli",
      "email": "omgitsraven@gmail.com"
    },
    {
      "name": "Oscar Paramo",
      "email": "oscar@paramo.dev"
    }
  ],
  "type": "module",
  "main": "./dist/aframe-room-component.min.js",
  "module": "./dist/aframe-room-component.esm.js",
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --mode development",
    "start": "vite",
    "start:https": "vite --mode https",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "changeset": "changeset",
    "release": "pnpm build && pnpm lint && pnpm coverage && changeset publish"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "@types/three": "0.184.1",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "neostandard": "0.14.1",
    "terser": "5.51.2",
    "three": "0.184.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "aframe": ">=1.5.0"
  }
}
